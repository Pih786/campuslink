DATABASE_URL=postgresql://user:password@localhost:5432/campuslink
JWT_SECRET=change-this-secret
PORT=5000
AI_SERVICE_URL=http://localhost:8000
JUDGE0_URL=https://ce.judge0.com
# Low-privilege role for the SQL Lab, scoped to its own schema only.
# Generate with: npx tsx scripts/setup-sql-lab-role.ts
SQL_LAB_DATABASE_URL=
CORS_ORIGIN=http://localhost:5173
# Public frontend URL used in emailed links (password reset etc.)
APP_URL=http://localhost:5173
# Email via Resend (https://resend.com). Leave empty in development: emails
# are then printed to the server console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=CampusLink <onboarding@resend.dev>
# Optional: YouTube Data API v3 key for embedded skill-gap video suggestions.
# Without it, curated YouTube search links are shown instead.
YOUTUBE_API_KEY=
# Email copies of shortlist, interview, offer and deadline notifications.
# Needs RESEND_API_KEY; set to "off" to keep notifications in-app only.
EMAIL_NOTIFICATIONS=on
